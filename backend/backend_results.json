  "sql_query": "SELECT\n  g.Name,\n  COUNT(t.TrackId) AS NumberOfTracks\nFROM Genre AS g\nJOIN Track AS t\n  ON g.GenreId = t.GenreId\nGROUP BY\n  g.Name\nORDER BY\n  NumberOfTracks DESC;",
  "sql_dialect": "MYSQL",
